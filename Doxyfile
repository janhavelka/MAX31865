# Doxygen configuration for MAX31865
# Generated and maintained for unified API documentation.

PROJECT_NAME           = "MAX31865"
PROJECT_NUMBER         = "1.0.0"
PROJECT_BRIEF          = "MAX31865 embedded library API documentation"
OUTPUT_DIRECTORY       = docs/doxygen
CREATE_SUBDIRS         = NO
ALLOW_UNICODE_NAMES    = NO
OUTPUT_LANGUAGE        = English

MARKDOWN_SUPPORT       = YES
TOC_INCLUDE_HEADINGS   = 3
AUTOLINK_SUPPORT       = YES
BUILTIN_STL_SUPPORT    = YES
JAVADOC_AUTOBRIEF      = YES
MULTILINE_CPP_IS_BRIEF = YES

EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
HIDE_FRIEND_COMPOUNDS  = NO

SHOW_INCLUDE_FILES     = YES
INLINE_INFO            = YES
SOURCE_BROWSER         = YES
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES
STRIP_CODE_COMMENTS    = NO

INPUT                  = README.md \
                         CHANGELOG.md \
                         CONTRIBUTING.md \
                         SECURITY.md \
                         include \
                         docs/README.md \
                         docs/api-overview.md \
                         docs/repository-contract.md \
                         docs/ARCHITECTURE.md \
                         docs/ARDUINO.md \
                         docs/CLI.md \
                         docs/ESP_IDF.md \
                         docs/TESTING.md \
                         docs/HARDWARE_BRINGUP.md \
                         docs/KNOWN_LIMITATIONS.md \
                         docs/DATASHEET_AUDIT.md \
                         docs/vendor-reference-code/README.md
FILE_PATTERNS          = *.h *.md
RECURSIVE              = YES
EXCLUDE_PATTERNS       = */.pio/* */.git/* */test/* */docs/doxygen/* */docs/extracted-md/* */docs/pdf-extracted-md/* */docs/_pdf_extracts/*
EXAMPLE_PATH           = examples/01_basic_bringup \
                         examples/02_continuous_sampling \
                         examples/03_one_shot \
                         examples/04_fault_diagnostics \
                         examples/05_rtd_configuration \
                         examples/06_diagnostic_cli \
                         examples/common
PREDEFINED             = DOXYGEN=1
INCLUDE_PATH           = test/stubs

# A path avoids matching every nested README.md by basename in Doxygen 1.9.8.
USE_MDFILE_AS_MAINPAGE = ./README.md
FULL_PATH_NAMES        = NO
SORT_MEMBER_DOCS       = YES
SORT_BRIEF_DOCS        = YES
SORT_MEMBERS_CTORS_1ST = YES

GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_COLORSTYLE        = AUTO_LIGHT
GENERATE_LATEX         = NO
GENERATE_XML           = NO
GENERATE_RTF           = NO
GENERATE_MAN           = NO

WARN_IF_UNDOCUMENTED   = YES
WARN_NO_PARAMDOC       = YES
WARN_IF_DOC_ERROR      = YES
WARN_AS_ERROR          = FAIL_ON_WARNINGS
QUIET                  = YES
